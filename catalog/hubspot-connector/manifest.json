{
  "id": "hubspot",
  "version": "1",
  "display_name": "HubSpot",
  "description": "HubSpot CRM: read contacts, companies and deals.",
  "documentation_url": "https://developers.hubspot.com/docs/api/overview",
  "base_url": "https://api.hubapi.com",
  "connection_specification": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "credentials"
    ],
    "properties": {
      "credentials": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "access_token"
        ],
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Private app access token",
            "rusty_secret": true,
            "rusty_order": 0,
            "description": "Settings \u2192 Integrations \u2192 Private Apps. Grant the CRM read scopes."
          }
        },
        "title": "Authentication",
        "rusty_order": 0
      }
    },
    "title": "HubSpot Connection"
  },
  "operations": [
    {
      "name": "check-connection",
      "description": "Verify the token is accepted.",
      "method": "GET",
      "path": "/crm/v3/objects/contacts",
      "effect": "read_only",
      "params_schema": {
        "type": "object"
      },
      "headers": [],
      "auth": [
        {
          "style": "bearer",
          "token": "{credentials.access_token}"
        }
      ],
      "max_response_bytes": null
    },
    {
      "name": "list-contacts",
      "description": "List contacts.",
      "method": "GET",
      "path": "/crm/v3/objects/contacts",
      "effect": "read_only",
      "params_schema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer"
          },
          "after": {
            "type": "string"
          },
          "properties": {
            "type": "string"
          }
        }
      },
      "headers": [],
      "auth": [
        {
          "style": "bearer",
          "token": "{credentials.access_token}"
        }
      ],
      "max_response_bytes": null
    },
    {
      "name": "list-companies",
      "description": "List companies.",
      "method": "GET",
      "path": "/crm/v3/objects/companies",
      "effect": "read_only",
      "params_schema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer"
          },
          "after": {
            "type": "string"
          },
          "properties": {
            "type": "string"
          }
        }
      },
      "headers": [],
      "auth": [
        {
          "style": "bearer",
          "token": "{credentials.access_token}"
        }
      ],
      "max_response_bytes": null
    },
    {
      "name": "list-deals",
      "description": "List deals.",
      "method": "GET",
      "path": "/crm/v3/objects/deals",
      "effect": "read_only",
      "params_schema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer"
          },
          "after": {
            "type": "string"
          },
          "properties": {
            "type": "string"
          }
        }
      },
      "headers": [],
      "auth": [
        {
          "style": "bearer",
          "token": "{credentials.access_token}"
        }
      ],
      "max_response_bytes": null
    }
  ],
  "check": "check-connection"
}
