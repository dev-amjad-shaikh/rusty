{
  "id": "bamboohr",
  "version": "1",
  "display_name": "BambooHR",
  "description": "BambooHR API: the employee directory and one employee's record (job title, department, supervisor, hire date, location, status), time-off requests and balances, and who is out. For organisations on BambooHR rather than Workday.",
  "documentation_url": "https://documentation.bamboohr.com/reference",
  "base_url": "https://api.bamboohr.com/api/gateway.php/{company}/v1",
  "connection_specification": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "BambooHR Connection",
    "type": "object",
    "required": [
      "company",
      "credentials"
    ],
    "additionalProperties": false,
    "properties": {
      "company": {
        "type": "string",
        "title": "Company subdomain",
        "rusty_order": 0,
        "description": "The part before .bamboohr.com.",
        "rusty_pattern_descriptor": "acme"
      },
      "credentials": {
        "type": "object",
        "title": "API key",
        "description": "Generated by an HR admin under their avatar → API Keys; the key's access is that person's permissions.",
        "required": [
          "api_key"
        ],
        "additionalProperties": false,
        "rusty_order": 1,
        "properties": {
          "api_key": {
            "type": "string",
            "title": "API key",
            "rusty_secret": true,
            "rusty_order": 0
          }
        }
      }
    }
  },
  "operations": [
    {
      "name": "check-connection",
      "description": "Verify the key is accepted.",
      "method": "GET",
      "path": "/employees/directory",
      "effect": "read_only",
      "params_schema": {
        "type": "object"
      },
      "auth": [
        {
          "style": "basic",
          "username": "{credentials.api_key}",
          "password": "x"
        }
      ]
    },
    {
      "name": "employee-directory",
      "description": "Everyone: id, displayName, jobTitle, department, location, supervisor, workEmail.",
      "method": "GET",
      "path": "/employees/directory",
      "effect": "read_only",
      "params_schema": {
        "type": "object"
      },
      "auth": [
        {
          "style": "basic",
          "username": "{credentials.api_key}",
          "password": "x"
        }
      ]
    },
    {
      "name": "get-employee",
      "description": "One employee's fields.",
      "method": "GET",
      "path": "/employees/{id}",
      "effect": "read_only",
      "params_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Employee id"
          },
          "fields": {
            "type": "string",
            "description": "Comma-separated field names",
            "default": "firstName,lastName,jobTitle,department,division,location,supervisor,hireDate,status,workEmail,employmentHistoryStatus"
          }
        },
        "required": [
          "id"
        ]
      },
      "auth": [
        {
          "style": "basic",
          "username": "{credentials.api_key}",
          "password": "x"
        }
      ]
    },
    {
      "name": "list-time-off-requests",
      "description": "Time-off requests in a window, optionally for one employee or one status (approved, denied, superceded, requested, canceled).",
      "method": "GET",
      "path": "/time_off/requests",
      "effect": "read_only",
      "params_schema": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string",
            "description": "YYYY-MM-DD"
          },
          "end": {
            "type": "string",
            "description": "YYYY-MM-DD"
          },
          "employeeId": {
            "type": "string",
            "description": "Employee id"
          },
          "status": {
            "type": "string",
            "description": "Status filter"
          }
        },
        "required": [
          "start",
          "end"
        ]
      },
      "auth": [
        {
          "style": "basic",
          "username": "{credentials.api_key}",
          "password": "x"
        }
      ]
    },
    {
      "name": "time-off-balance",
      "description": "Projected time-off balances for an employee as of a date, per policy.",
      "method": "GET",
      "path": "/employees/{id}/time_off/calculator",
      "effect": "read_only",
      "params_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Employee id"
          },
          "end": {
            "type": "string",
            "description": "As-of date YYYY-MM-DD"
          }
        },
        "required": [
          "id",
          "end"
        ]
      },
      "auth": [
        {
          "style": "basic",
          "username": "{credentials.api_key}",
          "password": "x"
        }
      ]
    },
    {
      "name": "whos-out",
      "description": "Who is out (approved time off and holidays) in a window.",
      "method": "GET",
      "path": "/time_off/whos_out",
      "effect": "read_only",
      "params_schema": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string",
            "description": "YYYY-MM-DD"
          },
          "end": {
            "type": "string",
            "description": "YYYY-MM-DD"
          }
        }
      },
      "auth": [
        {
          "style": "basic",
          "username": "{credentials.api_key}",
          "password": "x"
        }
      ]
    }
  ],
  "check": "check-connection"
}
