{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MemoryEntry",
  "description": "One entry in episodic memory.",
  "type": "object",
  "required": [
    "content",
    "created_at",
    "id"
  ],
  "properties": {
    "content": {
      "description": "The serialized content.",
      "type": "string"
    },
    "created_at": {
      "description": "When the entry was created.",
      "type": "string",
      "format": "date-time"
    },
    "id": {
      "description": "Stable entry identity.",
      "type": "string",
      "format": "uuid"
    },
    "provenance": {
      "description": "Optional provenance: who or what produced this entry.",
      "type": [
        "string",
        "null"
      ]
    }
  }
}
