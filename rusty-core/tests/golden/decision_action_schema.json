{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DecisionAction",
  "description": "One action in a [`DecisionEvent`]'s legal set. Closed enum: learned policies choose among declared actions, never free-form outputs — that is what keeps the learning problem mechanical (dense signals, closed spaces) instead of semantic.",
  "oneOf": [
    {
      "description": "Re-attempt the failed operation; `attempt` is the 1-based retry ordinal.",
      "type": "object",
      "required": [
        "action",
        "attempt"
      ],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "retry"
          ]
        },
        "attempt": {
          "description": "The 1-based retry ordinal being taken.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    {
      "description": "Give up on the operation and fail the run/step.",
      "type": "object",
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "abort"
          ]
        }
      }
    },
    {
      "description": "Apply a timeout of `millis` to the operation.",
      "type": "object",
      "required": [
        "action",
        "millis"
      ],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "set_timeout"
          ]
        },
        "millis": {
          "description": "The timeout bound in milliseconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      }
    },
    {
      "description": "Place a remote execution on worker `worker`.",
      "type": "object",
      "required": [
        "action",
        "worker"
      ],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "select_worker"
          ]
        },
        "worker": {
          "description": "The chosen worker's identity.",
          "type": "string"
        }
      }
    },
    {
      "description": "Cap concurrent executions at `limit`.",
      "type": "object",
      "required": [
        "action",
        "limit"
      ],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "set_concurrency"
          ]
        },
        "limit": {
          "description": "The maximum number of concurrent executions.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    {
      "description": "Persist a checkpoint at this boundary.",
      "type": "object",
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "write_checkpoint"
          ]
        }
      }
    },
    {
      "description": "Skip the checkpoint at this boundary.",
      "type": "object",
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "skip_checkpoint"
          ]
        }
      }
    }
  ]
}
