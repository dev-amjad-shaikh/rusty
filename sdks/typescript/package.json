{
  "name": "@rusty-runtime/client",
  "version": "0.5.0",
  "description": "Zero-dependency JS/TS client for rusty-server (HTTP + SSE). Works in Node.js >= 18 and browsers.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/"
  },
  "keywords": [
    "rusty",
    "agent",
    "llm",
    "graph",
    "sse",
    "agent-protocol"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dev-amjad-shaikh/rusty",
    "directory": "sdks/typescript"
  },
  "license": "MIT OR Apache-2.0"
}
