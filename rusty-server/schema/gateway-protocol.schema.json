    "AdmissionReason": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "description": "The closed run-admission verdict (`contracts:gateway-protocol`): decided at the exact branch that blocks or admits the run and carried verbatim to clients — never reverse-engineered from errors. Deliberately enumeration-safe about private agents.",
