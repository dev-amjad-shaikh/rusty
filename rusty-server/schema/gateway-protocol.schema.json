            "queued"
          ],
          "type": "string"
        },
        {
          "description": "Coalesced into an existing queued turn.",
          "enum": [
            "coalesced"
          ],
          "type": "string"
        },
        {
          "description": "Deferred by policy.",
          "enum": [
            "deferred"
          ],
          "type": "string"
        },
        {
          "description": "The runtime is offline.",
          "enum": [
            "runtime_offline"
          ],
          "type": "string"
        },
        {
          "description": "The runtime is present but unusable.",
          "enum": [
            "runtime_unusable"
          ],
          "type": "string"
        },
        {
          "description": "The request needs an agent runtime it cannot reach.",
          "enum": [
            "agent_runtime_required"
          ],
          "type": "string"
        },
        {
          "description": "Attribution requirements blocked the run.",
          "enum": [
            "attribution_blocked"
          ],
          "type": "string"
        },
        {
          "description": "The session already has an active run.",
          "enum": [
            "already_active"
          ],
          "type": "string"
        },
        {
          "description": "The run would trigger itself.",
          "enum": [
            "self_trigger_suppressed"
