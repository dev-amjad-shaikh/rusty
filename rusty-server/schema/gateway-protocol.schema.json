    "Pairing": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "description": "Device pairing: hello → challenge → signed response → paired (`contracts:gateway-protocol`). Loopback devices may auto-approve; remote devices always require operator approval. Tokens never travel in snapshots.",
      "oneOf": [
