          "description": "Redirect at the next drain boundary.",
          "enum": [
            "steer"
          ],
          "type": "string"
        },
        {
          "description": "Stage until a waking message.",
          "enum": [
            "inject"
          ],
          "type": "string"
        }
      ],
      "title": "SteeringVerb"
    },
