          "type": "string"
        },
        {
          "description": "Another run holds the turn lease.",
          "enum": [
            "lease_held"
          ],
          "type": "string"
        },
        {
          "description": "The caller lacks the required scope or credential.",
          "enum": [
            "unauthorized"
          ],
          "type": "string"
        }
      ],
      "title": "AdmissionReason"
    },
    "Frame": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "description": "One wire frame: typed request/response/event with a mandatory idempotency key on side-effecting methods, snapshot-on-connect, and monotonic event sequencing (`contracts:gateway-protocol`).",
      "oneOf": [
